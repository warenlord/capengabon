# Copie ce fichier en .env.local et complète les valeurs réelles de CAPEN.
# Aucune valeur ci-dessous n'est inventée : tant qu'un champ n'est pas rempli,
# le site affiche "Bientôt disponible" ou masque le bouton correspondant.

# Mot de passe d'accès à l'administration (/admin)
ADMIN_PASSWORD=change-moi

# Secret utilisé pour signer le cookie de session admin (chaîne aléatoire longue)
SESSION_SECRET=change-moi-aussi-avec-une-longue-chaine-aleatoire

# Numéro WhatsApp officiel CAPEN, format international sans "+" ni espace (ex: 237699000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Adresse e-mail officielle CAPEN
NEXT_PUBLIC_CONTACT_EMAIL=

# Téléphone officiel CAPEN (affichage uniquement)
NEXT_PUBLIC_CONTACT_PHONE=
